  $("productSaveBtn").textContent =
    "Update Product";


  $("productImagePreview").innerHTML =
    currentProductPhotoUrl
      ? `<img src="${escapeHTML(currentProductPhotoUrl)}">`
      : "";

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

}


async function deleteProduct(product){

  if(!confirm(
