        ${
          request.notes
          ? `
            <p>
              <strong>Notes:</strong>
              ${escapeHTML(request.notes)}
            </p>
          `
          : ""
        }


        <div class="actions">

          <select data-status>

            ${
              [
                "requested",
                "accepted",
                "in_progress",
                "completed",
                "cancelled"
              ].map(status=>`
                <option
                  value="${status}"
                  ${request.status === status ? "selected" : ""}>
