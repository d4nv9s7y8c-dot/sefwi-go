async function loadServiceRequests(){

  const container =
    $("serviceRequestsList");

  container.innerHTML =
    `<div class="loading">Loading requests...</div>`;


  try{

    const q =
      query(
        collection(db,"serviceRequests"),
        where(
          "providerId",
          "==",
          currentUser.uid
        )
