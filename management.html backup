$("productForm").addEventListener("submit",async(event)=>{

  event.preventDefault();

  if(!currentUser){
    return;
  }

  const button =
    $("productSaveBtn");

  button.disabled = true;

  button.textContent =
    "Saving...";

  try{

    let productId =
      $("productId").value.trim();

    const wasEditing =
      Boolean(productId);


    /*
      IMPORTANT:
      Create the Firestore document reference BEFORE
      uploading the image. This prevents the image from
      being uploaded twice.
    */

    let productRef;

    if(wasEditing){

      productRef =
        doc(
          db,
          "products",
          productId
        );

    }else{

      productRef =
        doc(
          collection(db,"products")
        );

      productId =
        productRef.id;

    }


    let photoUrl =
      currentProductPhotoUrl || "";


    const file =
      $("productPhoto").files[0];

    if(file){

      const blob =
        await compressImage(
          file,
          1200,
          .78
        );

      photoUrl =
        await uploadImage(
          blob,
          `products/${currentUser.uid}/${productId}/product.jpg`
        );

    }


    const businessName =
      currentBusiness?.name ||
      $("businessName").value.trim() ||
      "";


    const modifiers =
      currentProductModifiers
        .map(group=>({

          name:String(group.name || "").trim(),

          required:Boolean(group.required),

          multiple:Boolean(group.multiple),

          options:(group.options || [])
            .map(option=>({
              name:String(option.name || "").trim(),
              price:Number(option.price || 0)
            }))
            .filter(option=>option.name)

        }))
        .filter(group=>group.name);


    const data = {

      vendorId:
        currentUser.uid,

      vendorName:
        businessName,

      name:
        $("productName").value.trim(),

      price:
        Number(
          $("productPrice").value || 0
        ),

      description:
        $("productDescription").value.trim(),

      available:
        $("productAvailable").value === "true",

      photoUrl:

        photoUrl,

      modifiers:

        modifiers,

      updatedAt:
        serverTimestamp()

    };


    if(!data.name){
      throw new Error(
        "Product name is required."
      );
    }


    if(wasEditing){

      await updateDoc(
        productRef,
        data
      );

    }else{

      await setDoc(
        productRef,
        {
          ...data,
          createdAt:serverTimestamp()
        }
      );

    }


    resetProductForm();

    await loadProducts();

    showToast(
      wasEditing
        ? "Product updated."
        : "Product added.",
      "success"
    );

  }catch(error){

    console.error(error);

    showToast(
      friendlyFirebaseError(error),
      "error"
    );

  }finally{

    button.disabled = false;

    button.textContent =
      $("productId").value
        ? "Update Product"
        : "Save Product";

  }

});


