async function loadOrders(){

  const container =
    $("ordersList");

  container.innerHTML =
    `<div class="loading">Loading orders...</div>`;

  try{

    const q =
      query(
        collection(db,"orders"),
        where(
          "vendorId",
          "==",
          currentUser.uid
        )
      );

    const snap =
      await getDocs(q);

    const orders =
      snap.docs.map(d=>({
        id:d.id,
        ...d.data()
      }));


    orders.sort(
      (a,b)=>
        (b.createdAt?.seconds || 0) -
