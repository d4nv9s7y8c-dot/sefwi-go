$("propertyForm").addEventListener("submit",async(event)=>{

  event.preventDefault();

  if(!currentUser){
    return;
  }

  const button =
    $("propertySaveBtn");

  button.disabled = true;

  button.textContent =
    "Saving...";


  try{

    const propertyId =
      $("propertyId").value.trim();

    const wasEditing =
      Boolean(propertyId);


    let propertyRef;

    if(wasEditing){

      propertyRef =
        doc(
          db,
          "properties",
          propertyId
        );

    }else{

      propertyRef =
        doc(
          collection(db,"properties")
        );

    }


    const selectedFiles =
      Array.from(
        $("propertyPhotos").files || []
      ).slice(0,6);


    let photoUrls =
      [...currentPropertyPhotoUrls];


    if(selectedFiles.length){

      /*
        When new photos are selected while editing,
        use the newly selected set.
      */

      photoUrls = [];


      for(let i=0;i<selectedFiles.length;i++){

        const blob =
          await compressImage(
            selectedFiles[i],
            1400,
            .78
          );

        const url =
          await uploadImage(
            blob,
            `properties/${currentUser.uid}/${propertyRef.id}/photo-${Date.now()}-${i}.jpg`
          );

        photoUrls.push(url);

      }

    }


    const data = {

      ownerId:
        currentUser.uid,

      title:
        $("propertyTitle").value.trim(),

      purpose:
        $("propertyPurpose").value,

      type:
        $("propertyType").value,

      price:
        Number(
          $("propertyPrice").value || 0
        ),

      location:
        $("propertyLocation").value.trim(),

      bedrooms:
        Number(
          $("propertyBedrooms").value || 0
        ),

      bathrooms:
        Number(
          $("propertyBathrooms").value || 0
        ),

      ownerName:
        $("propertyOwner").value.trim(),

      phone:
        $("propertyPhone").value.trim(),

      description:
        $("propertyDescription").value.trim(),

      available:
        $("propertyAvailable").value === "true",

      photoUrls:
        photoUrls,

      photoUrl:
        photoUrls[0] || "",

      updatedAt:
        serverTimestamp()

    };


    if(!data.title){

      throw new Error(
        "Property title is required."
      );

    }


    if(wasEditing){

      await updateDoc(
        propertyRef,
        data
      );

    }else{

      await setDoc(
        propertyRef,
        {
          ...data,
          createdAt:serverTimestamp()
        }
      );

    }


    resetPropertyForm();

    await loadProperties();

    showToast(
      wasEditing
        ? "Property updated."
        : "Property added.",
      "success"
    );


  }catch(error){

    console.error(error);

    showToast(
      friendlyFirebaseError(error),
      "error"
    );

  }finally{

    button.disabled = false;

    button.textContent =
      $("propertyId").value
        ? "Update Property"
        : "Save Property";

  }

});


