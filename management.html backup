function dateText(timestamp){

  if(!timestamp){
    return "";
  }

  try{

    const date =
      timestamp.toDate
      ? timestamp.toDate()
      : new Date(timestamp);

    return date.toLocaleString();

  }catch(error){

    return "";
  }
}


