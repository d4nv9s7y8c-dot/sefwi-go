<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#008f87">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>SefwiGo Management</title>

<style>
:root{
  --primary:#008f87;
  --primary-dark:#006f69;
  --primary-light:#e7f7f5;
  --bg:#f4f7f7;
  --card:#ffffff;
  --text:#173331;
  --muted:#71817f;
  --border:#dfe9e7;
  --danger:#d93025;
  --warning:#b7791f;
  --success:#198754;
  --shadow:0 5px 18px rgba(0,0,0,.07);
  --radius:14px;
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  padding:0;
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
}

body{
  min-height:100vh;
}

button,input,select,textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.hidden{
  display:none!important;
}

/* AUTH */

.auth-screen{
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:20px;
  background:linear-gradient(145deg,#008f87,#00645f);
}

.auth-card{
  width:100%;
  max-width:450px;
  background:white;
  border-radius:22px;
  padding:26px;
  box-shadow:0 20px 60px rgba(0,0,0,.2);
}

.logo-box{
  text-align:center;
  margin-bottom:20px;
}

.logo{
  width:66px;
  height:66px;
  margin:auto;
  border-radius:18px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--primary);
  color:white;
  font-size:30px;
  font-weight:bold;
}

.logo-box h1{
  margin:12px 0 4px;
  font-size:25px;
}

.logo-box p{
  margin:0;
  color:var(--muted);
}

.auth-tabs{
  display:flex;
  background:#eef5f4;
  border-radius:10px;
  padding:4px;
  margin-bottom:18px;
}

.auth-tabs button{
  flex:1;
  border:0;
  padding:11px;
  border-radius:8px;
  background:transparent;
  color:var(--muted);
  font-weight:bold;
}

.auth-tabs button.active{
  background:white;
  color:var(--primary);
  box-shadow:0 2px 6px rgba(0,0,0,.08);
}

.form-group{
  margin-bottom:14px;
}

.form-group label{
  display:block;
  margin-bottom:6px;
  font-weight:bold;
  font-size:14px;
}

input,select,textarea{
  width:100%;
  border:1px solid var(--border);
  border-radius:10px;
  padding:12px 13px;
  background:white;
  color:var(--text);
  outline:none;
}

input:focus,select:focus,textarea:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 3px rgba(0,143,135,.1);
}

textarea{
  min-height:100px;
  resize:vertical;
}

.primary-btn,
.secondary-btn,
.danger-btn{
  border:0;
  border-radius:10px;
  padding:12px 15px;
  font-weight:bold;
}

.primary-btn{
  background:var(--primary);
  color:white;
}

.primary-btn:hover{
  background:var(--primary-dark);
}

.secondary-btn{
  background:var(--primary-light);
  color:var(--primary-dark);
}

.danger-btn{
  background:#fff0ef;
  color:var(--danger);
}

.full{
  width:100%;
}

.auth-link{
  text-align:center;
  margin-top:14px;
}

.auth-link button{
  border:0;
  background:none;
  color:var(--primary);
  font-weight:bold;
}

.error-box,
.success-box{
  border-radius:10px;
  padding:11px 12px;
  margin-bottom:14px;
  font-size:14px;
}

.error-box{
  background:#fff0ef;
  color:#a51f16;
}

.success-box{
  background:#eaf8ef;
  color:#146c36;
}

/* APP */

.app{
  min-height:100vh;
}

.topbar{
  height:64px;
  background:white;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 18px;
  position:sticky;
  top:0;
  z-index:50;
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:bold;
  font-size:19px;
}

.brand-mark{
  width:39px;
  height:39px;
  background:var(--primary);
  color:white;
  border-radius:11px;
  display:flex;
  justify-content:center;
  align-items:center;
  font-weight:bold;
}

.user-area{
  display:flex;
  align-items:center;
  gap:10px;
}

.user-name{
  font-size:13px;
  color:var(--muted);
}

.logout-btn{
  border:0;
  background:#fff0ef;
  color:var(--danger);
  padding:8px 10px;
  border-radius:9px;
  font-weight:bold;
}

.layout{
  display:flex;
  min-height:calc(100vh - 64px);
}

.sidebar{
  width:245px;
  background:white;
  border-right:1px solid var(--border);
  padding:15px 10px;
  flex-shrink:0;
}

.nav-title{
  color:#98a7a5;
  font-size:11px;
  text-transform:uppercase;
  font-weight:bold;
  padding:10px 11px 6px;
}

.nav-btn{
  width:100%;
  border:0;
  background:transparent;
  text-align:left;
  padding:12px;
  margin:2px 0;
  border-radius:10px;
  color:#526461;
  font-weight:bold;
}

.nav-btn:hover,
.nav-btn.active{
  background:var(--primary-light);
  color:var(--primary-dark);
}

.main{
  flex:1;
  min-width:0;
  padding:20px;
  max-width:1500px;
  margin:auto;
  width:100%;
}

.page-title{
  margin-bottom:18px;
}

.page-title h2{
  margin:0 0 4px;
}

.page-title p{
  margin:0;
  color:var(--muted);
  font-size:14px;
}

/* MOBILE NAV */

.mobile-nav{
  display:none;
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  background:white;
  border-top:1px solid var(--border);
  z-index:100;
  padding:5px;
  padding-bottom:max(5px,env(safe-area-inset-bottom));
}

.mobile-nav button{
  flex:1;
  border:0;
  background:transparent;
  padding:7px 3px;
  font-size:10px;
  color:var(--muted);
  font-weight:bold;
}

.mobile-nav button.active{
  color:var(--primary);
}

/* CARDS */

.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:17px;
  margin-bottom:18px;
}

.card-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:14px;
}

.card-header h3{
  margin:0;
  font-size:17px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
  margin-bottom:18px;
}

.stat{
  background:white;
  border:1px solid var(--border);
  border-radius:14px;
  padding:17px;
  box-shadow:var(--shadow);
}

.stat-label{
  color:var(--muted);
  font-size:13px;
}

.stat-value{
  font-size:28px;
  font-weight:bold;
  margin-top:7px;
  color:var(--primary-dark);
}

.grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.grid-3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
}

.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}

.span-2{
  grid-column:span 2;
}

/* LIST */

.list{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.list-item{
  border:1px solid var(--border);
  border-radius:12px;
  padding:13px;
  background:#fff;
}

.list-main{
  display:flex;
  gap:12px;
  align-items:flex-start;
}

.thumb{
  width:70px;
  height:70px;
  border-radius:10px;
  object-fit:cover;
  background:#e9f1f0;
  flex-shrink:0;
}

.item-info{
  flex:1;
  min-width:0;
}

.item-info h4{
  margin:0 0 5px;
  font-size:16px;
}

.item-info p{
  margin:3px 0;
  color:var(--muted);
  font-size:13px;
}

.actions{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  margin-top:10px;
}

.small-btn{
  border:0;
  padding:8px 10px;
  border-radius:8px;
  font-size:12px;
  font-weight:bold;
}

.edit-btn{
  background:var(--primary-light);
  color:var(--primary-dark);
}

.delete-btn{
  background:#fff0ef;
  color:var(--danger);
}

/* STATUS */

.status{
  display:inline-block;
  padding:5px 8px;
  border-radius:20px;
  font-size:11px;
  font-weight:bold;
  background:#eef3f2;
  color:#526461;
}

.status.new,
.status.requested{
  background:#fff5db;
  color:#8a5a00;
}

.status.accepted,
.status.ready,
.status.completed,
.status.delivered{
  background:#e9f8ee;
  color:#14763a;
}

.status.cancelled{
  background:#fff0ef;
  color:#b42318;
}

.status.preparing,
.status.assigned,
.status.picked_up,
.status.out_for_delivery,
.status.in_transit{
  background:#e8f2ff;
  color:#245a94;
}

/* IMAGE */

.image-preview{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-top:10px;
}

.image-preview img{
  width:90px;
  height:75px;
  object-fit:cover;
  border-radius:9px;
  border:1px solid var(--border);
}

.help{
  color:var(--muted);
  font-size:12px;
  margin-top:5px;
}

/* MODIFIERS */

.modifier-group{
  border:1px solid var(--border);
  border-radius:12px;
  padding:12px;
  margin-bottom:10px;
}

.modifier-head{
  display:grid;
  grid-template-columns:1fr auto auto auto;
  gap:8px;
  align-items:center;
}

.option-row{
  display:grid;
  grid-template-columns:1fr 100px auto;
  gap:7px;
  margin-top:8px;
}

/* EMPTY */

.empty{
  padding:30px 15px;
  text-align:center;
  color:var(--muted);
}

.empty strong{
  display:block;
  color:var(--text);
  margin-bottom:5px;
}

/* LOADING */

.loading{
  text-align:center;
  padding:30px;
  color:var(--muted);
}

.spinner{
  width:26px;
  height:26px;
  border:3px solid #dbe9e7;
  border-top-color:var(--primary);
  border-radius:50%;
  animation:spin .8s linear infinite;
  margin:0 auto 10px;
}

@keyframes spin{
  to{transform:rotate(360deg)}
}

/* TOAST */

.toast{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:500;
  max-width:360px;
  padding:13px 15px;
  border-radius:10px;
  background:#173331;
  color:white;
  box-shadow:0 10px 30px rgba(0,0,0,.2);
  transform:translateY(20px);
  opacity:0;
  pointer-events:none;
  transition:.25s;
}

.toast.show{
  transform:translateY(0);
  opacity:1;
}

.toast.error{
  background:#a51f16;
}

.toast.success{
  background:#146c36;
}

/* ORDER */

.order-items{
  margin:8px 0;
  padding-left:18px;
  color:#526461;
  font-size:13px;
}

.order-meta{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:6px;
  font-size:13px;
}

.order-meta div{
  padding:8px;
  background:#f7faf9;
  border-radius:7px;
}

/* RESPONSIVE */

@media(max-width:900px){
  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .grid-2{
    grid-template-columns:1fr;
  }

  .grid-3{
    grid-template-columns:1fr 1fr;
  }
}

@media(max-width:700px){
  .topbar{
    height:58px;
    padding:0 11px;
  }

  .brand{
    font-size:16px;
  }

  .brand-mark{
    width:35px;
    height:35px;
  }

  .user-name{
    display:none;
  }

  .layout{
    display:block;
  }

  .sidebar{
    display:none;
  }

  .main{
    padding:13px;
    padding-bottom:80px;
  }

  .mobile-nav{
    display:flex;
  }

  .stats{
    grid-template-columns:1fr 1fr;
    gap:9px;
  }

  .stat{
    padding:13px;
  }

  .stat-value{
    font-size:23px;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .span-2{
    grid-column:span 1;
  }

  .grid-3{
    grid-template-columns:1fr;
  }

  .modifier-head{
    grid-template-columns:1fr;
  }

  .option-row{
    grid-template-columns:1fr 85px auto;
  }

  .card{
    padding:13px;
  }

  .list-main{
    flex-direction:row;
  }

  .thumb{
    width:58px;
    height:58px;
  }

  .toast{
    left:12px;
    right:12px;
    bottom:75px;
    max-width:none;
  }
}
</style>
</head>

<body>

<!-- ================= AUTH ================= -->

<div id="authScreen" class="auth-screen">

  <div class="auth-card">

    <div class="logo-box">
      <div class="logo">S</div>
      <h1>SefwiGo Management</h1>
      <p>Partners • Delivery • Services • Admin</p>
    </div>

    <div class="auth-tabs">
      <button id="loginTab" class="active" onclick="showAuthMode('login')">
        Sign In
      </button>
      <button id="signupTab" onclick="showAuthMode('signup')">
        Create Account
      </button>
    </div>

    <div id="authError" class="error-box hidden"></div>
    <div id="authSuccess" class="success-box hidden"></div>

    <!-- LOGIN -->

    <form id="loginForm">

      <div class="form-group">
        <label>Email</label>
        <input id="loginEmail" type="email" required autocomplete="email">
      </div>

      <div class="form-group">
        <label>Password</label>
        <input id="loginPassword" type="password" required autocomplete="current-password">
      </div>

      <button id="loginBtn" class="primary-btn full" type="submit">
        Sign In
      </button>

      <div class="auth-link">
        <button type="button" onclick="resetPassword()">
          Forgot password?
        </button>
      </div>

    </form>

    <!-- SIGNUP -->

    <form id="signupForm" class="hidden">

      <div class="form-group">
        <label>Full Name</label>
        <input id="signupName" type="text" required>
      </div>

      <div class="form-group">
        <label>Email</label>
        <input id="signupEmail" type="email" required autocomplete="email">
      </div>

      <div class="form-group">
        <label>Phone</label>
        <input id="signupPhone" type="tel">
      </div>

      <div class="form-group">
        <label>Management Type</label>

        <select id="signupType" required>
          <option value="">Select type</option>
          <option value="vendor">Business / Vendor</option>
          <option value="property_owner">Property Owner / Agent</option>
          <option value="both">Business + Property</option>
          <option value="service_provider">Home Service Provider</option>
          <option value="delivery_partner">Delivery Partner</option>
        </select>

      </div>

      <div class="form-group">
        <label>Password</label>
        <input id="signupPassword" type="password" minlength="6" required>
      </div>

      <button id="signupBtn" class="primary-btn full" type="submit">
        Create Management Account
      </button>

    </form>

  </div>

</div>


<!-- ================= MAIN APP ================= -->

<div id="app" class="app hidden">

  <header class="topbar">

    <div class="brand">
      <div class="brand-mark">S</div>
      <span>SefwiGo Management</span>
    </div>

    <div class="user-area">
      <span id="userName" class="user-name"></span>
      <button class="logout-btn" onclick="logout()">Logout</button>
    </div>

  </header>


  <div class="layout">

    <!-- SIDEBAR -->

    <aside class="sidebar">

      <div class="nav-title">Management</div>

      <button class="nav-btn active" data-page="dashboard" onclick="openPage('dashboard')">
        📊 Dashboard
      </button>

      <button class="nav-btn" data-page="business" onclick="openPage('business')">
        🏪 Business
      </button>

      <button class="nav-btn" data-page="products" onclick="openPage('products')">
        🍔 Menu & Products
      </button>

      <button class="nav-btn" data-page="orders" onclick="openPage('orders')">
        🧾 Orders
      </button>

      <button class="nav-btn" data-page="properties" onclick="openPage('properties')">
        🏠 Properties
      </button>

      <button class="nav-btn" data-page="services" onclick="openPage('services')">
        🛠 Home Services
      </button>

      <button class="nav-btn" data-page="delivery" onclick="openPage('delivery')">
        🚚 Parcel Delivery
      </button>

      <button class="nav-btn" data-page="admin" onclick="openPage('admin')">
        ⚙️ Admin
      </button>

    </aside>


    <!-- MAIN -->

    <main class="main">

      <!-- DASHBOARD -->

      <section id="page-dashboard" class="page">

        <div class="page-title">
          <h2>Dashboard</h2>
          <p>Manage your SefwiGo business and services.</p>
        </div>

        <div class="stats">

          <div class="stat">
            <div class="stat-label">Products</div>
            <div id="statProducts" class="stat-value">0</div>
          </div>

          <div class="stat">
            <div class="stat-label">Orders</div>
            <div id="statOrders" class="stat-value">0</div>
          </div>

          <div class="stat">
            <div class="stat-label">Properties</div>
            <div id="statProperties" class="stat-value">0</div>
          </div>

          <div class="stat">
            <div class="stat-label">Services</div>
            <div id="statServices" class="stat-value">0</div>
          </div>

        </div>


        <div class="grid-2">

          <div class="card">

            <div class="card-header">
              <h3>Account</h3>
            </div>

            <div id="dashboardAccount">
              Loading...
            </div>

          </div>


          <div class="card">

            <div class="card-header">
              <h3>Business Status</h3>
            </div>

            <div id="dashboardBusiness">
              Loading...
            </div>

          </div>

        </div>

      </section>


      <!-- BUSINESS -->

      <section id="page-business" class="page hidden">

        <div class="page-title">
          <h2>Business</h2>
          <p>Add and manage restaurants, shops, groceries, retail businesses and services.</p>
        </div>


        <div class="card">

          <div class="card-header">
            <h3>Business Profile</h3>
            <span id="businessStatus" class="status">Not saved</span>
          </div>

          <form id="businessForm">

            <div class="form-grid">

              <div class="form-group">
                <label>Business Name *</label>
                <input id="businessName" required>
              </div>

              <div class="form-group">
                <label>Business Category *</label>

                <select id="businessCategory" required>
                  <option value="">Select category</option>
                  <option>Restaurant</option>
                  <option>Food</option>
                  <option>Groceries</option>
                  <option>Drinks</option>
                  <option>Retail</option>
                  <option>Fashion</option>
                  <option>Electronics</option>
                  <option>Beauty</option>
                  <option>Pharmacy</option>
                  <option>Services</option>
                  <option>Home Services</option>
                  <option>Transport</option>
                  <option>Hotel / Accommodation</option>
                  <option>Property</option>
                  <option>Other</option>
                </select>

              </div>

              <div class="form-group">
                <label>Phone</label>
                <input id="businessPhone" type="tel">
              </div>

              <div class="form-group">
                <label>Location</label>
                <input id="businessLocation" placeholder="Example: Sefwi Wiawso">
              </div>

              <div class="form-group span-2">
                <label>Description</label>
                <textarea id="businessDescription"></textarea>
              </div>

              <div class="form-group span-2">
                <label>Business Logo / Photo</label>
                <input id="businessPhoto" type="file" accept="image/*" capture="environment">
                <div class="help">You can take a photo directly with your phone.</div>
                <div id="businessImagePreview" class="image-preview"></div>
              </div>

            </div>

            <button id="businessSaveBtn" class="primary-btn" type="submit">
              Save Business
            </button>

          </form>

        </div>


        <div class="card">

          <div class="card-header">
            <h3>Business Information</h3>
          </div>

          <div id="businessSummary" class="empty">
            <strong>No business loaded</strong>
            Save your business profile above.
          </div>

        </div>

      </section>


      <!-- PRODUCTS -->

      <section id="page-products" class="page hidden">

        <div class="page-title">
          <h2>Menu & Products</h2>
          <p>Add products, food, drinks, groceries and other items customers can order.</p>
        </div>


        <div class="card">

          <div class="card-header">
            <h3 id="productFormTitle">Add Product</h3>
            <button class="secondary-btn" onclick="resetProductForm()">Clear</button>
          </div>

          <form id="productForm">

            <input id="productId" type="hidden">

            <div class="form-grid">

              <div class="form-group">
                <label>Product Name *</label>
                <input id="productName" required>
              </div>

              <div class="form-group">
                <label>Price *</label>
                <input id="productPrice" type="number" min="0" step="0.01" required>
              </div>

