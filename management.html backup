async function editProduct(product){

  openPage("products");

  $("productId").value =
    product.id;

  $("productName").value =
    product.name || "";

  $("productPrice").value =
    product.price ?? "";

  $("productDescription").value =
    product.description || "";

  $("productAvailable").value =
    product.available === false
      ? "false"
      : "true";

  currentProductPhotoUrl =
    product.photoUrl || "";

  currentProductModifiers =
    JSON.parse(
      JSON.stringify(
        product.modifiers || []
      )
    );

  renderModifierGroups();

