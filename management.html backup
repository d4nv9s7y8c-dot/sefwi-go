              await updateDoc(
                doc(
                  db,
                  "serviceRequests",
                  request.id
                ),
                {
                  status:status,
                  updatedAt:serverTimestamp()
                }
              );

              showToast(
                "Service request updated.",
                "success"
              );

              await loadServiceRequests();

            }catch(error){

              showToast(
                friendlyFirebaseError(error),
                "error"
              );

            }

          }
        );


      container.appendChild(div);

    });


  }catch(error){

    console.error(error);

    container.innerHTML =
      `<div class="error-box">
        ${escapeHTML(friendlyFirebaseError(error))}
      </div>`;

  }

