async function loadParcelDeliveries(){

  const container =
    $("parcelList");

  container.innerHTML =
    `<div class="loading">Loading delivery requests...</div>`;


  try{

    const roles =
      currentProfile?.roles || {};


    let snap;


    /*
      Delivery partners see deliveries assigned to them.
      Admins can see all deliveries, provided Firestore rules
      also authorize the request.
    */

    if(roles.admin){

      snap =
        await getDocs(
          collection(
            db,
            "parcelDeliveries"
          )
        );

    }else{

      const q =
        query(
          collection(db,"parcelDeliveries"),
          where(
            "assignedTo",
            "==",
            currentUser.uid
          )
        );

      snap =
        await getDocs(q);

    }


    const deliveries =
      snap.docs.map(d=>({
        id:d.id,
        ...d.data()
      }));


    deliveries.sort(
      (a,b)=>
        (b.createdAt?.seconds || 0) -
        (a.createdAt?.seconds || 0)
    );


    if(!deliveries.length){

      container.innerHTML = `
        <div class="empty">
          <strong>No parcel deliveries</strong>
          New parcel delivery requests will appear here.
        </div>
      `;

      return;
    }


    container.innerHTML = "";


    deliveries.forEach(delivery=>{

      const div =
        document.createElement("div");

