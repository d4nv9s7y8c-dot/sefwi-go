    const snap =
      await getDocs(q);

    const requests =
      snap.docs.map(d=>({
        id:d.id,
        ...d.data()
      }));


    requests.sort(
      (a,b)=>
        (b.createdAt?.seconds || 0) -
        (a.createdAt?.seconds || 0)
    );


    if(!requests.length){

      container.innerHTML = `
        <div class="empty">
          <strong>No service requests</strong>
          Customer requests will appear here.
        </div>
      `;

      return;
    }


    container.innerHTML = "";


    requests.forEach(request=>{

      const div =
        document.createElement("div");

      div.className =
        "list-item";


      div.innerHTML = `

        <div class="card-header">

