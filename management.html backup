function renderModifierGroups(){

  const container =
    $("modifierGroups");

  container.innerHTML = "";

  if(!currentProductModifiers.length){

    container.innerHTML = `
      <div class="empty">
        <strong>No modifier groups</strong>
        Modifiers are optional.
      </div>
    `;

    return;
  }


  currentProductModifiers.forEach(
    (group,index)=>{

      const div =
        document.createElement("div");

      div.className =
        "modifier-group";

      div.innerHTML = `

        <div class="modifier-head">

          <input
            placeholder="Group name"
            value="${escapeHTML(group.name || "")}"
            data-group-name="${index}"
          >

          <label style="font-size:12px;">
            <input
              type="checkbox"
              ${group.required ? "checked" : ""}
              data-group-required="${index}"
            >
            Required
          </label>

          <label style="font-size:12px;">
            <input
              type="checkbox"
              ${group.multiple ? "checked" : ""}
              data-group-multiple="${index}"
            >
            Multiple
          </label>

          <button
            type="button"
            class="delete-btn small-btn"
            data-remove-group="${index}">
            Remove
          </button>

        </div>

        <div
          style="margin-top:10px;"
          id="options-${index}">
        </div>

        <button
          type="button"
          class="secondary-btn small-btn"
          style="margin-top:9px;"
          data-add-option="${index}">
          + Add Option
        </button>

      `;

      container.appendChild(div);

      renderModifierOptions(index);

    }
  );


  container
    .querySelectorAll("[data-remove-group]")
    .forEach(btn=>{

      btn.addEventListener("click",()=>{

        const index =
          Number(
            btn.dataset.removeGroup
          );

        currentProductModifiers.splice(
          index,
          1
        );

        renderModifierGroups();

      });

    });


  container
    .querySelectorAll("[data-add-option]")
    .forEach(btn=>{

      btn.addEventListener("click",()=>{

        const index =
          Number(
            btn.dataset.addOption
          );

        currentProductModifiers[index]
          .options
          .push({
            name:"",
            price:0
          });

        renderModifierGroups();

      });

    });


  container
    .querySelectorAll("[data-group-name]")
    .forEach(input=>{

      input.addEventListener("input",()=>{

        const index =
          Number(input.dataset.groupName);

        currentProductModifiers[index]
          .name =
          input.value;

      });

    });


  container
    .querySelectorAll("[data-group-required]")
    .forEach(input=>{

      input.addEventListener("change",()=>{

        const index =
          Number(input.dataset.groupRequired);

        currentProductModifiers[index]
          .required =
          input.checked;

      });

    });


  container
    .querySelectorAll("[data-group-multiple]")
    .forEach(input=>{

      input.addEventListener("change",()=>{

        const index =
          Number(input.dataset.groupMultiple);

        currentProductModifiers[index]
          .multiple =
          input.checked;

      });

    });

}


function renderModifierOptions(groupIndex){

  const container =
    $("options-" + groupIndex);

  if(!container){
    return;
  }

  const group =
    currentProductModifiers[groupIndex];

  if(!group.options){
    group.options = [];
  }


  container.innerHTML =
    group.options.length
      ? ""
      : `<div class="help">No options yet.</div>`;


  group.options.forEach(
    (option,optionIndex)=>{

      const row =
        document.createElement("div");

      row.className =
        "option-row";

      row.innerHTML = `

        <input
          placeholder="Option name"
          value="${escapeHTML(option.name || "")}"
        >

        <input
          type="number"
          min="0"
          step="0.01"
          placeholder="Price"
          value="${Number(option.price || 0)}"
        >

        <button
          type="button"
          class="delete-btn small-btn">
          ×
        </button>

      `;

      const inputs =
        row.querySelectorAll("input");

      inputs[0].addEventListener(
        "input",
        ()=>{
          option.name =
            inputs[0].value;
        }
      );

      inputs[1].addEventListener(
        "input",
        ()=>{
          option.price =
            Number(inputs[1].value || 0);
        }
      );

      row.querySelector("button")
        .addEventListener(
          "click",
          ()=>{
            group.options.splice(
              optionIndex,
              1
            );
            renderModifierGroups();
          }
        );

      container.appendChild(row);

    }
  );

}


window.addModifierGroup = function(){

